{
  "name": "news-scraper",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "format": "prettier --write package.json tsconfig.json eslint.config.mjs prettier.config.mjs scripts src test README.md",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.mjs prettier.config.mjs scripts src test README.md",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node scripts/run-tests.mjs \"test/unit/**/*.test.ts\"",
    "test:integration": "node scripts/run-tests.mjs \"test/integration/**/*.test.ts\"",
    "test:db": "node scripts/run-tests.mjs \"test/database/**/*.test.ts\"",
    "start:web": "node src/app/web/main.ts",
    "start:worker": "node src/app/worker/main.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.22.0"
  }
}
