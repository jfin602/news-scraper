{
  "name": "news-scraper",
  "version": "0.19.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "format": "prettier --write package.json tsconfig.json eslint.config.mjs prettier.config.mjs scripts src test README.md",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.mjs prettier.config.mjs scripts src test README.md",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs --test-concurrency=4 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\" \"test/collection/**/*.test.ts\"",
    "test:unit": "node scripts/run-tests.mjs --test-concurrency=4 \"test/unit/**/*.test.ts\"",
    "test:integration": "node scripts/run-tests.mjs --test-concurrency=4 \"test/integration/**/*.test.ts\"",
    "test:collection": "node scripts/run-tests.mjs --test-concurrency=4 \"test/collection/**/*.test.ts\"",
    "test:security": "node scripts/run-tests.mjs --test-concurrency=2 \"test/security/**/*.test.ts\"",
    "test:browser": "node scripts/run-tests.mjs --test-concurrency=2 \"test/browser/**/*.test.ts\"",
    "test:db": "node --env-file-if-exists=.env scripts/run-tests.mjs --test-concurrency=2 --test-global-setup=test/support/database/database-test-global-setup.ts \"test/database/**/*.test.ts\"",
    "test:db:focused": "node --env-file-if-exists=.env scripts/run-tests.mjs --test-concurrency=1 --test-global-setup=test/support/database/database-test-global-setup.ts",
    "test:live-sources": "node --env-file-if-exists=.env scripts/run-tests.mjs --test-concurrency=1 \"test/live-sources/**/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup-database.ts",
    "db:restore": "node --env-file-if-exists=.env scripts/restore-database.ts",
    "db:backup:prune": "node scripts/prune-database-backups.ts",
    "test:recovery": "node --env-file-if-exists=.env scripts/run-tests.mjs --test-concurrency=1 test/recovery/**/*.test.ts",
    "db:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-database.ts config/publication.json",
    "editorial:apply": "node --env-file-if-exists=.env scripts/apply-editorial-configuration.ts config/editorial.json",
    "publication:set-public-status": "node --env-file-if-exists=.env scripts/set-publication-public-status.ts",
    "collect:endpoint": "node --env-file-if-exists=.env src/app/worker/collect-main.ts",
    "docs:snapshot": "node scripts/create-docs-snapshot.mjs",
    "codex:phase": "node scripts/codex-phase.mjs",
    "codex:phase:validate": "node scripts/validate-codex-phase.mjs",
    "start:web": "node --env-file-if-exists=.env src/app/web/main.ts",
    "start:worker": "node --env-file-if-exists=.env src/app/worker/main.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "eslint": "^10.8.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "css-what": "^7.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "pg": "^8.22.0"
  }
}
